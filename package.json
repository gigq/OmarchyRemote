{
  "name": "omarchy-remote",
  "description": "Touch shell for an Omarchy desktop: terminal, files, browser tabs, Herdr agents, and host TUIs from a phone, tablet, or browser window.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test scripts/worker.test.mjs scripts/keyboard.test.mjs scripts/remote-client.test.mjs",
    "test:live": "node --test scripts/live-server.test.mjs",
    "test:backend": "node --test scripts/backend.test.mjs",
    "test:ui": "playwright test",
    "test:browser-adapter": "node --test scripts/browser-integration.test.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "ws": "8.21.3"
  }
}
