# Installed by deploy/install.sh; the checkout and node paths are filled in from the template in deploy/.
[Unit]
Description=Omarchy Remote web shell and live-reload server
After=network.target

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@NODE@ @REPO@/scripts/serve.mjs
EnvironmentFile=%h/.config/omarchy-remote/backend.env
Environment=PORT=4187
Environment=PYTHON=/usr/bin/python3
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
