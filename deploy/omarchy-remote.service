# Installed by deploy/install.sh; the checkout path is filled in from the template in deploy/.
[Unit]
Description=Omarchy Remote host backend
After=network.target

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@REPO@/backend/target/release/omarchy-remote
EnvironmentFile=%h/.config/omarchy-remote/backend.env
Environment=SHELL=/bin/bash
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
KillMode=control-group

[Install]
WantedBy=default.target
