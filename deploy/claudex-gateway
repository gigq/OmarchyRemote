#!/usr/bin/env bash
# claudex on a machine without the proxy: Claude Code through the CLIProxyAPI on another host,
# named in ~/.config/claudex/env (CLAUDEX_URL=http://tars:8317, CLAUDEX_KEY=…), set up as the
# proxy host's own claudex does. Corral runs Claude X agents the same way, with or without this.
set -euo pipefail
ENV="$HOME/.config/claudex/env"
[[ -r "$ENV" ]] || { echo "claudex: no $ENV (CLAUDEX_URL and CLAUDEX_KEY)" >&2; exit 1; }
# shellcheck source=/dev/null
source "$ENV"
export ANTHROPIC_BASE_URL="${CLAUDEX_URL:?claudex: CLAUDEX_URL is not set in $ENV}"
export ANTHROPIC_AUTH_TOKEN="${CLAUDEX_KEY:?claudex: CLAUDEX_KEY is not set in $ENV}"
export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
export CLAUDE_CODE_ALWAYS_ENABLE_EFFORT=1
export ENABLE_TOOL_SEARCH=true
export ENABLE_PROMPT_CACHING_1H=1
export API_TIMEOUT_MS=3000000
effort_args=("--effort" "high")
settings_args=("--settings" '{"env":{"CLAUDE_CODE_AUTO_COMPACT_WINDOW":"990000"}}')
for arg in "$@"; do
  [[ "$arg" == "--effort" || "$arg" == --effort=* ]] && effort_args=()
  [[ "$arg" == "--settings" || "$arg" == --settings=* ]] && settings_args=()
done
exec claude --dangerously-skip-permissions "${effort_args[@]}" "${settings_args[@]}" "$@"
