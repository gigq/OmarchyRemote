{
  "manifest_version": 3,
  "name": "Omarchy Remote Browser",
  "version": "0.1.0",
  "description": "Mirror Vivaldi windows, workspaces and tabs to your private Omarchy Remote app.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Omarchy Remote Browser",
    "default_popup": "options.html"
  }
}
